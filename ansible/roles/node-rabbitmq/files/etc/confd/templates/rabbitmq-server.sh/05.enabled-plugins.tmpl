flush /usr/local/rabbitmq/etc/rabbitmq/enabled_plugins << ENABLED_PLUGINS_EOF
[
{{- if eq (getv "/host/role") "disc" }}
  rabbitmq_delayed_message_exchange,
{{- end }}
{{- if eq (getv "/env/prometheus_plugins_enabled") "true" }}
  rabbitmq_prometheus,
{{- end }}
  rabbitmq_management,
  rabbitmq_mqtt,
  rabbitmq_shovel,
  rabbitmq_shovel_management,
  rabbitmq_federation,
  rabbitmq_federation_management,
  rabbitmq_stomp,
  rabbitmq_web_mqtt,
  rabbitmq_web_stomp,
  rabbitmq_peer_discovery_etcd
].
ENABLED_PLUGINS_EOF